<UserControl x:Class="ProjectLauncher.Desktop.Views.RunView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ProjectLauncher.Desktop.Controls">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="230"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="运行项目" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding ProjectDescription}" Style="{StaticResource Hint}" MaxHeight="40"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Button Content="打开输出目录" Click="OpenOutput_Click"/><Button Content="项目设置  ↗" Click="Settings_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="22,18,22,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="AdvancedCheck" Content="高级参数" FontSize="11" Checked="Advanced_Changed" Unchecked="Advanced_Changed" VerticalAlignment="Center"/><Button Content="重置" Style="{StaticResource TextButton}" Click="Reset_Click" Margin="10,0,0,0"/></StackPanel><StackPanel><TextBlock Text="PARAMETERS" Style="{StaticResource Micro}" Margin="0,0,0,4"/><TextBlock Text="参数配置" Style="{StaticResource SectionTitle}"/></StackPanel></DockPanel>
          <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="启动动作" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ActionBox" SelectionChanged="Action_Changed" IsEnabled="{Binding CanRun}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="参数预设" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed"/></StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0"><Button Content="＋" ToolTip="保存当前参数为预设" Style="{StaticResource IconButton}" Click="SavePreset_Click"/><Button Content="−" ToolTip="删除选中的预设" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="DeletePreset_Click"/></StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0"><controls:ParameterForm x:Name="Form" Margin="0,0,10,0" IsEnabled="{Binding CanRun}"/></ScrollViewer>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" Background="{DynamicResource HeroGradient}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
          <TextBlock Text="READY TO LAUNCH" Style="{StaticResource Micro}" Margin="0,0,0,6"/>
          <TextBlock Text="本次执行" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"><TextBlock Text="{Binding RuntimeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
          <DockPanel Margin="0,6,0,10"><Button Content="管理 →" Style="{StaticResource TextButton}" DockPanel.Dock="Right" Padding="4,4" MinHeight="28" Click="Environment_Click"/><TextBlock Text="{Binding EnvironmentBadge}" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
          <DockPanel><Button Content="复制" Style="{StaticResource TextButton}" DockPanel.Dock="Right" Click="CopyCommand_Click" Padding="4,0" MinHeight="20"/><TextBlock Text="实际命令 · 脱敏预览" Style="{StaticResource Micro}" VerticalAlignment="Center"/></DockPanel>
          <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,6,0,0" Height="85" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PanelBackground}"/>
          <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" FontSize="10" Margin="0,6,0,12" MaxHeight="38"/>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding Elapsed}" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/><TextBlock Text="{Binding Status}" FontSize="12" MaxHeight="32" Margin="0,0,8,0"/></DockPanel>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,0,12"/>
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Height="44" Click="Start_Click" IsEnabled="{Binding CanRun}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRun}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="开始运行" Foreground="White" FontWeight="SemiBold"/></StackPanel></Button>
          <Button Content="停止任务" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="{Binding Busy}" Margin="0,8,0,0"/>
          <TextBlock Text="代码在项目环境中运行。" Style="{StaticResource Hint}" TextAlignment="Center" FontSize="10" Margin="0,8,0,0"/>
         </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12,16,14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" FontSize="11" VerticalAlignment="Center"/><Button Content="导出可见日志" Style="{StaticResource TextButton}" Click="ExportLog_Click" Margin="8,0,0,0"/><Button Content="清空" Style="{StaticResource TextButton}" Click="ClearLog_Click"/></StackPanel><TextBlock Text="执行记录" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TabControl Grid.Row="1" Margin="0,6,0,0">
          <TabItem Header="实时日志"><TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{DynamicResource TerminalBackground}" Foreground="{DynamicResource TerminalForeground}" BorderThickness="0" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></TabItem>
          <TabItem Header="历史运行"><ListBox x:Name="HistoryList" ItemsSource="{Binding History}" MouseDoubleClick="History_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Started, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource Hint}"/><TextBlock Grid.Column="1" Text="{Binding ActionLabel}"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="3" Text="{Binding DurationSeconds, StringFormat={}{0:0.0}s}" Style="{StaticResource Hint}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
