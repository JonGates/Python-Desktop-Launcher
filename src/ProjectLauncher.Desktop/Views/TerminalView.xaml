<UserControl x:Class="ProjectLauncher.Desktop.Views.TerminalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="项目终端" Style="{StaticResource PageTitle}"/><TextBlock Text="一个持续的 Shell 会话，自动进入当前项目环境。不是一条命令启动一个进程的伪终端。" Style="{StaticResource Hint}"/></StackPanel><Button Grid.Column="1" Content="打开系统终端  ↗" Click="External_Click" Margin="18,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanRun}"/></Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,16"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="CONPTY  /  UTF-8" Foreground="{DynamicResource AccentBrush}" FontSize="10"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="环境" Style="{StaticResource Hint}" Margin="0,0,10,0"/><TextBlock Text="{Binding RuntimeLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,24,0"/><TextBlock Text="目录" Style="{StaticResource Hint}" Margin="0,0,10,0"/><TextBlock Text="{Binding ProjectRoot}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="440"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Background="{DynamicResource TerminalBackground}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="复制" Click="Copy_Click" Style="{StaticResource TextButton}"/><Button Content="粘贴" Click="Paste_Click" Style="{StaticResource TextButton}"/><Button Content="Ctrl+C" Click="Interrupt_Click" Style="{StaticResource TextButton}"/><Button Content="关闭全部" Click="CloseAll_Click" Style="{StaticResource TextButton}"/></StackPanel><WrapPanel><Button Content="＋ PowerShell" Click="NewPowerShell_Click" Margin="0,0,7,0" IsEnabled="{Binding CanRun}"/><Button Content="＋ CMD" Click="NewCmd_Click" Margin="0,0,7,0" IsEnabled="{Binding CanRun}"/><Button Content="＋ Python" Click="NewPython_Click" IsEnabled="{Binding CanRun}"/></WrapPanel></DockPanel>
        <TabControl x:Name="TermTabs" Grid.Row="1"><TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TerminalForeground}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="8,0,6,0" VerticalAlignment="Center"/><Button Content="×" Tag="{Binding}" Click="CloseTab_Click" Style="{StaticResource TextButton}" Padding="3,0" MinHeight="18"/></StackPanel></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><ContentPresenter Content="{Binding Control}"/></DataTemplate></TabControl.ContentTemplate></TabControl>
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="30"><Border Width="64" Height="64" CornerRadius="18" Background="#262642" HorizontalAlignment="Center" Margin="0,0,0,20"><Path Data="{StaticResource IconTerminal}" Stroke="#A19AFF" StrokeThickness="1.3" Stretch="Uniform" Width="32" Height="32"/></Border><TextBlock Text="在项目环境里，自由运行" Foreground="{DynamicResource TerminalForeground}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="点击上方按钮新建会话。cd、环境变量和 Python REPL 状态会保留；关闭会话会结束它的归属进程。" Foreground="#8794AD" FontSize="13" LineHeight="23" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><DockPanel><Button Content="发送输入 ↵" DockPanel.Dock="Right" Margin="10,0,0,0" Click="SendLine_Click"/><TextBox x:Name="InputLineBox" ToolTip="中文输入辅助行：发送到当前会话，不会新建 Shell。Enter 发送。" KeyDown="InputLine_KeyDown"/></DockPanel><TextBlock Text="中文可使用上方辅助输入行。Ctrl+Shift+C/V 复制粘贴 · 滚轮查看历史 · Ctrl+滚轮调整字号。复杂 TUI 可切换系统终端。" Style="{StaticResource Hint}" FontSize="11" Margin="0,9,0,0"/></StackPanel>
  </Grid>
</UserControl>
