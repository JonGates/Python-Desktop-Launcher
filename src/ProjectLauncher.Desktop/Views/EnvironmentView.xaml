<UserControl x:Class="ProjectLauncher.Desktop.Views.EnvironmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
      <TextBlock Text="环境管理" Style="{StaticResource PageTitle}"/><TextBlock Text="明确解释器归属。环境准备好之前，不把你的项目交给系统 Python。" Style="{StaticResource Hint}" Margin="0,0,0,23"/>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PYTHON INTERPRETER" Style="{StaticResource Micro}"/><TextBlock Text="{Binding EnvironmentVersion}" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="实际运行后验证 sys.prefix" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROJECT ENVIRONMENT" Style="{StaticResource Micro}"/><TextBlock Text="{Binding RuntimeLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding EnvironmentBadge}" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}" Background="{DynamicResource HeroGradient}"><StackPanel><TextBlock Text="ISOLATED BY DESIGN" Style="{StaticResource Micro}"/><TextBlock Text="壳与项目分离" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="C# 界面不安装到业务 .venv" Style="{StaticResource Hint}"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <TextBlock Text="项目运行环境" Style="{StaticResource SectionTitle}"/><TextBlock Text="初始化和同步可能联网并修改项目虚拟环境；会先显示将执行的命令，由你确认。" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="项目目录" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ProjectRoot, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="1" Text="项目 Python" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="PythonPathBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="2" Text="uv 可执行文件" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="UvPathBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="3" Text="配置文件" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="ConfigPathBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True"/>
        </Grid>
        <WrapPanel Margin="0,20,0,0"><Button Content="创建 / 同步环境" Style="{StaticResource PrimaryButton}" Click="Initialize_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,10,8"/><Button Content="检查解释器" Click="Probe_Click" IsEnabled="{Binding CanRun}" Margin="0,0,10,8"/><Button Content="打开项目终端" Click="Terminal_Click" Margin="0,0,10,8"/><Button Content="复制诊断信息" Click="Copy_Click" Margin="0,0,10,8"/><Button Content="修改环境设置" Style="{StaticResource TextButton}" Click="Settings_Click" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="检查结果" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding EnvironmentDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,8,0,0" MinHeight="100"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="停止当前操作" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="{Binding Busy}"/><TextBlock Text="初始化输出" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeBox}" Height="180" Background="{DynamicResource TerminalBackground}" Foreground="{DynamicResource TerminalForeground}"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
