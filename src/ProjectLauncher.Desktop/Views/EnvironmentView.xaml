<UserControl x:Class="ProjectLauncher.Desktop.Views.EnvironmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ProjectLauncher.Desktop.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
      <TextBlock Text="{loc:LocalizedText Ui.010}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:LocalizedText Ui.020}" Style="{StaticResource Hint}" Margin="0,0,0,23"/>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PYTHON INTERPRETER" Style="{StaticResource Micro}"/><TextBlock Text="{Binding EnvironmentVersion}" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{loc:LocalizedText Ui.021}" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROJECT ENVIRONMENT" Style="{StaticResource Micro}"/><TextBlock Text="{Binding RuntimeLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding EnvironmentBadge}" Style="{StaticResource Hint}"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}" Background="{DynamicResource HeroGradient}"><StackPanel><TextBlock Text="ISOLATED BY DESIGN" Style="{StaticResource Micro}"/><TextBlock Text="{loc:LocalizedText Ui.022}" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{loc:LocalizedText Ui.023}" Style="{StaticResource Hint}"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <TextBlock Text="{loc:LocalizedText Ui.024}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{loc:LocalizedText Ui.025}" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:LocalizedText Ui.026}" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ProjectRoot, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="1" Text="{loc:LocalizedText Ui.027}" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="PythonPathBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="2" Text="{loc:LocalizedText Ui.028}" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="UvPathBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="3" Text="{loc:LocalizedText Ui.029}" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBox x:Name="ConfigPathBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True"/>
        </Grid>
        <WrapPanel Margin="0,20,0,0"><Button Content="{loc:LocalizedText Ui.030}" Style="{StaticResource PrimaryButton}" Click="Initialize_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,10,8"/><Button Content="{loc:LocalizedText Ui.031}" Click="Probe_Click" IsEnabled="{Binding CanRun}" Margin="0,0,10,8"/><Button Content="{loc:LocalizedText Ui.032}" Click="Terminal_Click" Margin="0,0,10,8"/><Button Content="{loc:LocalizedText Ui.033}" Click="Copy_Click" Margin="0,0,10,8"/><Button Content="{loc:LocalizedText Ui.034}" Style="{StaticResource TextButton}" Click="Settings_Click" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{loc:LocalizedText Ui.035}" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding EnvironmentDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,8,0,0" MinHeight="100"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{loc:LocalizedText Ui.036}" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="{Binding Busy}"/><TextBlock Text="{loc:LocalizedText Ui.037}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeBox}" Height="180" Background="{DynamicResource TerminalBackground}" Foreground="{DynamicResource TerminalForeground}"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
