<Window x:Class="ProjectLauncher.Desktop.Views.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次接入 · Project Launcher" Width="760" Height="570" MinWidth="520" MinHeight="420"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="绑定这个 Python 项目" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="首次使用：确认项目与环境，生成项目启动配置。" Style="{StaticResource Hint}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="项目目录" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ProjectPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="项目目录"/>
            <TextBlock Text="配置将保存在此目录的 launcher.yaml 中。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Python 虚拟环境" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="DiscoveryStatus" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="EnvironmentBox" AutomationProperties.Name="Python 虚拟环境" SelectionChanged="Environment_Changed">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="选择目录…" Margin="10,0,0,0" Click="BrowseEnvironment_Click"/>
            </Grid>
            <TextBlock x:Name="EnvironmentPath" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
            <TextBlock Text="绑定后，在启动动作中配置命令和参数。" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="环境检测仅检查文件。创建配置后，可在环境管理页检查解释器；创建或同步依赖需要单独确认。" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/>
      <Button x:Name="CreateButton" Content="绑定并进入" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Create_Click"/>
    </StackPanel>
  </Grid>
</Window>
