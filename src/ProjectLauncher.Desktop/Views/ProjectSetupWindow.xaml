<Window x:Class="ProjectLauncher.Desktop.Views.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ProjectLauncher.Desktop.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:LocalizedText Ui.038}" Width="760" Height="570" MinWidth="520" MinHeight="420"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="{loc:LocalizedText Ui.039}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{loc:LocalizedText Ui.040}" Style="{StaticResource Hint}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{loc:LocalizedText Ui.026}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ProjectPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{loc:LocalizedText Ui.026}"/>
            <TextBlock Text="{loc:LocalizedText Ui.041}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{loc:LocalizedText Ui.042}" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="DiscoveryStatus" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="EnvironmentBox" AutomationProperties.Name="{loc:LocalizedText Ui.042}" SelectionChanged="Environment_Changed">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="{loc:LocalizedText Ui.043}" Margin="10,0,0,0" Click="BrowseEnvironment_Click"/>
            </Grid>
            <TextBlock x:Name="EnvironmentPath" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
            <TextBlock Text="{loc:LocalizedText Ui.044}" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{loc:LocalizedText Ui.045}" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton" Content="{loc:LocalizedText Ui.046}" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/>
      <Button x:Name="CreateButton" Content="{loc:LocalizedText Ui.047}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Create_Click"/>
    </StackPanel>
  </Grid>
</Window>
