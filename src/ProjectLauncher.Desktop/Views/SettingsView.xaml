<UserControl x:Class="ProjectLauncher.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="项目设置" Style="{StaticResource PageTitle}"/><TextBlock Text="把命令配置成易用的表单。只修改 launcher.yaml，不改你的业务代码。" Style="{StaticResource Hint}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="15,0,0,0"><TextBlock Text="SCHEMA v1" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border></Grid>
    <TabControl x:Name="SettingTabs" Grid.Row="1">
      <TabItem Header="基本信息">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="项目标识" Style="{StaticResource SectionTitle}"/><TextBlock Text="会显示在运行页面、侧栏和窗口标题中。" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="项目名称 *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="项目版本" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VersionBox"/></StackPanel></Grid>
            <TextBlock Text="项目说明" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74"/>
            <TextBlock Text="输出目录（用于「打开输出目录」按钮）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="OutputBox"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="项目环境" Style="{StaticResource SectionTitle}"/><TextBlock Text="GUI 任务与项目终端共用同一 .venv。切换环境前必须关闭所有运行中的会话。" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="环境模式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ModeBox"/><TextBlock Text="existing 使用已有环境；venv 创建传统环境；uv 同步 pyproject。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="默认终端" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ShellBox"/></StackPanel></Grid>
            <TextBlock Text="项目目录（相对于配置文件）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseProject_Click"/><TextBox x:Name="ProjectDirBox"/></DockPanel>
            <TextBlock Text="项目虚拟环境目录" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseVenv_Click"/><TextBox x:Name="VenvBox"/></DockPanel>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="初始化 Python 要求" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PythonBox"/><TextBlock Text="可留空。有 uv 时可填写 3.12；也可填初始化解释器完整路径。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="依赖清单（仅 venv 模式）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequirementsBox"/><TextBlock Text="没有依赖清单就留空，不会自动生成 requirements.txt。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
            <TextBlock Text="附加环境变量（JSON 对象）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="EnvBox" Style="{StaticResource CodeBox}" Height="100"/><TextBlock Text="例如 { &quot;APP_MODE&quot;: &quot;dev&quot; }。不要写真实密码；PATH / VIRTUAL_ENV 等由启动器管理。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="启动命令">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="启动动作" Style="{StaticResource SectionTitle}" Margin="8,4,0,12"/><ListBox x:Name="ActionList" Grid.Row="1" SelectionChanged="ActionSelection_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><Button Content="＋ 添加动作" Click="AddAction_Click" Margin="0,10,0,8"/><Button Content="删除所选动作" Style="{StaticResource TextButton}" Click="DeleteAction_Click"/></StackPanel></Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
            <TextBlock Text="动作编辑" Style="{StaticResource SectionTitle}"/><TextBlock Text="每个条目是一个独立 argv 参数；包含空格的路径也只放一行，不额外加引号。" Style="{StaticResource Hint}" Margin="0,0,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="动作 ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ActionIdBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ActionLabelBox"/></StackPanel></Grid>
            <TextBlock Text="程序与参数（第一项是程序名，例如 python）" Style="{StaticResource FieldLabel}" Margin="0,20,0,7"/>
            <ListBox x:Name="ArgvList" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button Content="×" Tag="{Binding}" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="7,0,0,0" Click="RemoveArg_Click"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"/></DockPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/></Style></ListBox.ItemContainerStyle></ListBox>
            <WrapPanel Margin="0,8,0,0"><Button Content="＋ 添加 argv" Click="AddArg_Click" Margin="0,0,8,0"/><Button Content="↑ 上移" Click="ArgUp_Click" Margin="0,0,8,0"/><Button Content="↓ 下移" Click="ArgDown_Click"/></WrapPanel>
            <CheckBox x:Name="AllParametersCheck" Content="使用全部表单参数" Margin="0,22,0,12" Checked="AllParameters_Changed" Unchecked="AllParameters_Changed"/>
            <TextBlock Text="指定参数名（逗号分隔，顺序就是追加顺序）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ActionParametersBox"/><TextBlock Text="取消「全部」并留空，表示不附加任何参数；不会自动猜测脚本参数。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            <TextBlock Text="超时秒数（0 表示不限时）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="TimeoutBox"/>
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="参数设计器">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="8,4,0,12"><TextBlock Text="表单字段" Style="{StaticResource SectionTitle}"/></DockPanel><ListBox x:Name="ParameterList" Grid.Row="1" SelectionChanged="ParameterSelection_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Type}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="8,0,0,0"/><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><Button Content="＋ 添加参数" Style="{StaticResource PrimaryButton}" Click="AddParameter_Click" Margin="0,10,0,10"/><UniformGrid Columns="2"><Button Content="复制" Click="DuplicateParameter_Click" Margin="0,0,5,7"/><Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteParameter_Click" Margin="5,0,0,7"/><Button Content="↑ 上移" Click="ParameterUp_Click" Margin="0,0,5,0"/><Button Content="↓ 下移" Click="ParameterDown_Click" Margin="5,0,0,0"/></UniformGrid></StackPanel></Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterEditor" Margin="0,0,8,0">
            <TextBlock Text="字段属性" Style="{StaticResource SectionTitle}"/><TextBlock Text="名称与说明会直接展示在运行页，业务脚本不需要依赖任何 GUI 库。" Style="{StaticResource Hint}" Margin="0,0,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="参数名 *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ParamNameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="界面名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ParamLabelBox"/></StackPanel></Grid>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="控件类型" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ParamTypeBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="传参方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BindingBox"/></StackPanel></Grid>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="命令行开关" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ArgumentBox"/><TextBlock Text="argument 模式，例如 --input" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="环境变量名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EnvNameBox"/><TextBlock Text="env 模式，例如 MY_API_KEY" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
            <TextBlock Text="默认值" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="DefaultBox" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="不要填写真实密码。boolean 类型使用 true / false；可选参数留空时不传入。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            <TextBlock Text="参数说明" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="ParamDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>
            <WrapPanel Margin="0,18,0,0"><CheckBox x:Name="RequiredCheck" Content="必填" Margin="0,0,24,12"/><CheckBox x:Name="AdvancedParamCheck" Content="高级参数" Margin="0,0,24,12"/><CheckBox x:Name="MustExistCheck" Content="路径必须存在" Margin="0,0,24,12"/><CheckBox x:Name="SecretCheck" Content="敏感值" Margin="0,0,0,12"/></WrapPanel>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最小值（数字类型）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="最大值（数字类型）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxBox"/></StackPanel></Grid>
            <TextBlock Text="下拉选项（每行一个值）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="OptionsBox" Style="{StaticResource CodeBox}" Height="90"/>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="布尔传参规则" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BooleanModeBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="关闭时开关（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FalseArgumentBox"/></StackPanel></Grid>
            <TextBlock Text="显示条件（每行 参数名=期望值，多个条件同时满足）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="ConditionsBox" Style="{StaticResource CodeBox}" Height="80"/><TextBlock Text="例如 mode=prefix。条件不满足时既不显示，也不传这个参数。复杂字符串可使用完整 YAML 编辑。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="完整 YAML">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="从表单生成 YAML" Click="GenerateYaml_Click" Margin="0,0,8,0"/><Button Content="应用 YAML 到表单" Click="ApplyYaml_Click"/></StackPanel><TextBlock Text="高级编辑器 · 当前页保存时以这里的内容为准" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,15,0"/></DockPanel><TextBox x:Name="YamlBox" Grid.Row="1" Style="{StaticResource CodeBox}"/></Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,20,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="放弃并重新加载" Click="Reload_Click" Margin="0,0,10,0"/><Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanEdit}" MinWidth="140"/></StackPanel><TextBlock x:Name="DirtyLabel" Text="保存时校验配置并保留 .bak 备份" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,18,0"/></DockPanel></Border>
  </Grid>
</UserControl>
