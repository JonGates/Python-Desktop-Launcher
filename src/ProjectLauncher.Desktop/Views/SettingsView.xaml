<UserControl x:Class="ProjectLauncher.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ProjectLauncher.Desktop.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:LocalizedText Ui.011}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:LocalizedText Ui.069}" Style="{StaticResource Hint}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="15,0,0,0"><TextBlock Text="SCHEMA v1" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border></Grid>
    <TabControl x:Name="SettingTabs" Grid.Row="1">
      <TabItem Header="{loc:LocalizedText Ui.070}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{loc:LocalizedText Ui.071}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{loc:LocalizedText Ui.072}" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:LocalizedText Ui.073}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:LocalizedText Ui.074}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VersionBox"/></StackPanel></Grid>
            <TextBlock Text="{loc:LocalizedText Ui.075}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74"/>
            <TextBlock Text="{loc:LocalizedText Ui.076}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="OutputBox"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{loc:LocalizedText Ui.077}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{loc:LocalizedText Ui.078}" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:LocalizedText Ui.079}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ModeBox"/><TextBlock Text="{loc:LocalizedText Ui.080}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:LocalizedText Ui.081}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ShellBox"/></StackPanel></Grid>
            <TextBlock Text="{loc:LocalizedText Ui.082}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><DockPanel><Button Content="{loc:LocalizedText Ui.083}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseProject_Click"/><TextBox x:Name="ProjectDirBox"/></DockPanel>
            <TextBlock Text="{loc:LocalizedText Ui.084}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><DockPanel><Button Content="{loc:LocalizedText Ui.083}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseVenv_Click"/><TextBox x:Name="VenvBox"/></DockPanel>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:LocalizedText Ui.085}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PythonBox"/><TextBlock Text="{loc:LocalizedText Ui.086}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:LocalizedText Ui.087}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequirementsBox"/><TextBlock Text="{loc:LocalizedText Ui.088}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
            <TextBlock Text="{loc:LocalizedText Ui.089}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><TextBox x:Name="EnvBox" Style="{StaticResource CodeBox}" Height="100"/><TextBlock Text="{loc:LocalizedText Ui.090}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:LocalizedText Ui.008}"><ContentControl x:Name="ActionWorkspaceHost"/></TabItem>
      <TabItem Header="{loc:LocalizedText Ui.091}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:LocalizedText Ui.092}" Click="GenerateYaml_Click" Margin="0,0,8,0"/><Button Content="{loc:LocalizedText Ui.093}" Click="ApplyYaml_Click"/></StackPanel><TextBlock Text="{loc:LocalizedText Ui.094}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,15,0"/></DockPanel><TextBox x:Name="YamlBox" Grid.Row="1" Style="{StaticResource CodeBox}"/></Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:LocalizedText Ui.095}" Click="Reload_Click" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="{loc:LocalizedText Ui.096}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanEdit}" MinWidth="140"/></StackPanel><TextBlock x:Name="DirtyLabel" Text="{loc:LocalizedText Ui.097}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,18,0"/></DockPanel></Border>
  </Grid>
</UserControl>
